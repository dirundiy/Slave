# Copy this file to .env.local and paste your Spotify app's Client ID.
# The Client ID is public by design (PKCE needs no client secret), so it is safe in the frontend.
VITE_SPOTIFY_CLIENT_ID=

# Must match a Redirect URI in your Spotify app settings exactly.
VITE_SPOTIFY_REDIRECT_URI=http://127.0.0.1:5173/callback
